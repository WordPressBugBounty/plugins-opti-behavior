msgstr "¡Hecho!"

#: opti-behavior/includes/class-opti-behavior-review-banner.php:205
msgid "Remind me later"
msgstr "Recordármelo más tarde"

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:163
msgid "Stop A/B Test"
msgstr "Detener test A/B"

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:167
msgid "Declare Best-Performing Variant"
msgstr "Declarar la variante con mejor rendimiento"

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:168
msgid ""
"Opti Behavior will declare the variant with the highest conversion rate as "
"the winner based on the current test results."
msgstr ""
"Opti-Behavior declarará ganadora la variante con la tasa de conversión más "
"alta según los resultados actuales del test."

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:171
msgid ""
"This will disable the permanent winner change and return the test to "
"Completed. The declared winner and historical data will be preserved."
msgstr ""
"Esto desactivará el cambio permanente del ganador y devolverá el test al "
"estado Completado. Se conservarán el ganador declarado y los datos "
"históricos."

#. translators: %d: maximum number of variants allowed per A/B test.
#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:216
msgid "Free plan limit reached: maximum %d variants per test."
msgstr "Límite del plan gratuito alcanzado: máximo %d variantes por test."

#. translators: %d: maximum number of goals allowed per A/B test.
#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:218
