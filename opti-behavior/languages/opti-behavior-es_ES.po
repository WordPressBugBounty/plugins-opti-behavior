#: opti-behavior/includes/trait-opti-behavior-settings-views.php:3574
msgid ""
"Heatmap storage mode is \"database\"; the cleanup only runs in file storage "
"mode."
msgstr ""
"El modo de almacenamiento de mapas de calor es «base de datos»; la limpieza "
"solo se ejecuta en modo de almacenamiento en archivos."

