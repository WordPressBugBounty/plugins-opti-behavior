#. translators: 1: comma-separated list of module labels, 2: comma-separated
#. list of detected optimizer/cache plugin names.
#: opti-behavior/includes/class-opti-behavior-tracker-heartbeat.php:682
msgid ""
"Your site received visitors in the last 24 hours, but %1$s recorded zero "
"events in that time. This usually means one of your caching or optimization "
"plugins (%2$s) is stripping or merging the tracking script before it can run"
" — with no visible error."
msgstr ""
"Su sitio recibió visitantes en las últimas 24 horas, pero %1$s registró cero"
" eventos en ese tiempo. Esto normalmente significa que uno de sus plugins de"
" caché u optimización (%2$s) está eliminando o combinando el script de "
"seguimiento antes de que pueda ejecutarse — sin ningún error visible."

#: opti-behavior/includes/class-opti-behavior-tracker-heartbeat.php:687
msgid "a caching or optimization plugin"
msgstr "un plugin de caché u optimización"

#. translators: 1: comma-separated list of module labels, 2: likely
#. optimizer/cache plugin name.
#: opti-behavior/includes/class-opti-behavior-tracker-heartbeat.php:690
msgid ""
"Your site received visitors in the last 24 hours, but %1$s recorded zero "
"events in that time. This usually means %2$s is stripping or merging the "
"tracking script before it can run — with no visible error."
msgstr ""
"Su sitio recibió visitantes en las últimas 24 horas, pero %1$s registró cero"
" eventos en ese tiempo. Esto normalmente significa que %2$s está eliminando "
"o combinando el script de seguimiento antes de que pueda ejecutarse — sin "
"ningún error visible."

