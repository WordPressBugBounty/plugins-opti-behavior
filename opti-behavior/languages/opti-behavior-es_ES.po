#: opti-behavior/includes/trait-opti-behavior-ajax-handlers.php:3114
msgid "Successfully deleted selected data from %1$d tables and %2$d files."
msgstr ""
"Se eliminaron correctamente los datos seleccionados de %1$d tablas y %2$d "
"archivos."

#: opti-behavior/includes/trait-opti-behavior-settings-views.php:793
msgid ""
"Select the data categories you want to delete. All options are selected by "
"default."
msgstr ""
"Seleccione las categorías de datos que desea eliminar. Todas las opciones "
"están seleccionadas de forma predeterminada."

#: opti-behavior/includes/trait-opti-behavior-assets.php:567
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:795
msgid "Deselect All"
msgstr "Deseleccionar todo"

#: opti-behavior/includes/trait-opti-behavior-ajax-handlers.php:3251
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:801
msgid "Sessions & Pageviews"
msgstr "Sesiones y vistas de página"

#: opti-behavior/includes/trait-opti-behavior-settings-views.php:801
msgid "Sessions, pageviews, daily stats"
msgstr "Sesiones, vistas de página, estadísticas diarias"

#: opti-behavior/includes/trait-opti-behavior-settings-views.php:801
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:805
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:821
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:825
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:833
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:837
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:841
msgid "tables"
msgstr "tablas"

#: opti-behavior/includes/trait-opti-behavior-settings-views.php:805
msgid "Unique visitors, bot visits"
msgstr "Visitantes únicos, visitas de bots"

#: opti-behavior/includes/trait-opti-behavior-settings-views.php:809
