msgstr "Impresiones A/B"

#: opti-behavior/includes/trait-opti-behavior-ajax-handlers.php:1529
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:3873
msgid "A/B Goals"
msgstr "Objetivos A/B"

#: opti-behavior/includes/trait-opti-behavior-ajax-handlers.php:1530
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:3872
msgid "A/B Variants"
msgstr "Variantes A/B"

#: opti-behavior/includes/trait-opti-behavior-ajax-handlers.php:1531
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:3871
msgid "A/B Tests"
msgstr "Tests A/B"

#: opti-behavior/includes/trait-opti-behavior-ajax-handlers.php:1533
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:3877
msgid "A/B Targeting Rules"
msgstr "Reglas de segmentación A/B"

#: opti-behavior/includes/trait-opti-behavior-ajax-handlers.php:1534
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:3878
msgid "A/B Schedule"
msgstr "Programación A/B"

