msgstr ""
"100 persone iniziano > 60 aggiungono al carrello > 30 procedono al checkout "
"= il Funnel mostra dove si perdono clienti."

#: opti-behavior/includes/tooltip-helper.php:234
msgid "1920x1080 is a common computer screen size."
msgstr "1920x1080 è una risoluzione schermo comune per computer."

#: opti-behavior/includes/tooltip-helper.php:1298
msgid "2m 30s means most readers stay about two and a half minutes."
msgstr ""
"2m 30s significa che la maggior parte dei lettori resta circa due minuti e "
"mezzo."

#: opti-behavior/includes/trait-opti-behavior-settings-views.php:481
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:583
