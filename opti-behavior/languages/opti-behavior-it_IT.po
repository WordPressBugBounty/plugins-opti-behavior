msgid "Lead generation"
msgstr "Lead generation"

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:454
msgid "Signup"
msgstr "Registrazione"

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:455
msgid "Blog"
msgstr "Blog"

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:456
msgid "Traffic"
msgstr "Traffico"

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:459
msgid "Loading suggestions…"
msgstr "Caricamento suggerimenti…"

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:460
msgid "Could not load funnel suggestions."
msgstr "Impossibile caricare i suggerimenti di Funnel."

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:461
msgid "Request failed. Please try again."
msgstr "Richiesta non riuscita. Riprovi."

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:463
msgid ""
"Ready-made funnels built from your own URLs. Nothing is created until you "
"say so."
msgstr ""
"Funnel già pronti, costruiti a partire dagli URL del suo sito. Non viene "
"creato nulla finché non lo decide lei."

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:464
msgid ""
"No funnel suggestions for this site right now. Build one manually, or re-"
"scan after installing a store, form or membership plugin."
msgstr ""
"Al momento nessun suggerimento di Funnel per questo sito. Ne crei uno "
"manualmente, oppure esegua una nuova scansione dopo aver installato un "
"plugin di negozio, moduli o abbonamenti."

