#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:213
msgid "Free plan limit reached: maximum %d goals per test."
msgstr "Limite del piano gratuito raggiunto: massimo %d obiettivi per test."

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:232
#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:1234
msgid "WordPress Content"
msgstr "Contenuto WordPress"

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:234
#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:1286
msgid "Search pages, posts, products, and public content..."
msgstr "Cerca pagine, articoli, prodotti e contenuti pubblici..."

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:235
msgid "Searching targets..."
msgstr "Ricerca target..."

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:236
msgid "No matching targets found."
msgstr "Nessun target corrispondente trovato."

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:237
#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:1293
msgid "Load more results"
msgstr "Carica altri risultati"

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:239
msgid "Clear target"
msgstr "Cancella target"

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:240
#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:1259
msgid "Selected target"
msgstr "Target selezionato"

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:241
#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:1315
msgid "Quick targets"
msgstr "Target rapidi"

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:242
msgid "Please enter a same-site URL."
msgstr "Inserisca un URL dello stesso sito."

