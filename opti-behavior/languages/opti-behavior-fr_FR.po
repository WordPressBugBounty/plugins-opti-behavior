#: opti-behavior/includes/tooltip-helper.php:1522
msgid "Shows how fast your pages load for real visitors."
msgstr ""
"Affiche la vitesse de chargement de vos pages pour de vrais visiteurs."

#: opti-behavior/includes/tooltip-helper.php:1526
msgid "Broken Links Tab"
msgstr "Onglet Liens Cassés"

