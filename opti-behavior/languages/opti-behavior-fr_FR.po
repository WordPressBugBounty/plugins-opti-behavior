msgid "✦ Pick Element Visually"
msgstr "✦ Choisir l’élément visuellement"

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:218
msgid "Upgrade to Pro to pick elements visually from the live page."
msgstr ""
"Passez à Pro pour choisir visuellement les éléments depuis la page en ligne."

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:1534
msgid "Audience Targeting — Pro only"
msgstr "Ciblage d’audience — Pro uniquement"

#: opti-behavior/admin/class-opti-behavior-ab-test-page.php:1537
msgid "Audience Targeting"
