"Plugin tables use %1$s MB — under the configured cap (%2$s MB), nothing was "
"deleted."
msgstr ""
"Les tables du plugin utilisent %1$s Mo — sous le plafond configuré (%2$s "
"Mo), rien n’a été supprimé."

#: opti-behavior/includes/class-opti-behavior-db-size-cap.php:412
msgid "Plugin tables: %1$s MB of a %2$s MB cap."
msgstr "Tables du plugin : %1$s Mo sur un plafond de %2$s Mo."

#: opti-behavior/includes/class-opti-behavior-db-size-cap.php:414
msgid "Plugin tables: %s MB (no overall cap set)."
msgstr "Tables du plugin : %s Mo (aucun plafond global défini)."

