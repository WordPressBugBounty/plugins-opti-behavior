msgstr ""
"Devons-nous suivre les pages qui listent plusieurs articles, comme les pages"
" de catégories ?"

#: opti-behavior/includes/tooltip-helper.php:430
msgid "Show JavaScript messages in browser developer tools."
msgstr ""
"Afficher les messages JavaScript dans les outils de développement du "
"navigateur."

#: opti-behavior/includes/tooltip-helper.php:272
msgid ""
"Show a bar with click counts at the edge of heatmaps. This helps you see the"
" total number of interactions at each scroll depth."
msgstr ""
"Afficher une barre avec le nombre de clics au bord des cartes de chaleur. "
"Cela vous aide à voir le nombre total d’interactions à chaque profondeur de "
"défilement."

#: opti-behavior/includes/trait-opti-behavior-settings-views.php:461
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:563
msgid "Show all data points"
msgstr "Afficher tous les points de données"

#: opti-behavior/includes/tooltip-helper.php:934
msgid "Show clicks from logged-in users only, guests only, or everyone."
msgstr ""
"Afficher les clics des utilisateurs connectés uniquement, des invités "
"uniquement ou de tous."

#: opti-behavior/includes/tooltip-helper.php:929
msgid "Show clicks from people using certain web browsers."
msgstr "Afficher les clics de personnes utilisant certains navigateurs web."

#: opti-behavior/includes/tooltip-helper.php:928
msgid ""
"Show clicks only from specific browsers like Chrome, Firefox, or Safari. "
"Helps identify browser-specific behavior patterns."
msgstr ""
"Afficher les clics uniquement de navigateurs spécifiques comme Chrome, "
"Firefox ou Safari. Aide à identifier les modèles de comportement spécifiques"
" aux navigateurs."

#: opti-behavior/includes/tooltip-helper.php:923
msgid ""
"Show clicks only from visitors in specific countries. Useful for seeing how "
"different regions interact with your page."
msgstr ""
"Afficher les clics uniquement des visiteurs de pays spécifiques. Utile pour "
"voir comment différentes régions interagissent avec votre page."

#: opti-behavior/includes/trait-opti-behavior-settings-views.php:594
msgid "Show count bar"
msgstr "Afficher la barre de comptage"

#: opti-behavior/includes/tooltip-helper.php:1606
msgid "Show data based on where visitors came from."
msgstr "Afficher les données en fonction de la provenance des visiteurs."

#: opti-behavior/includes/tooltip-helper.php:1588
msgid "Show data only for specific browsers."
msgstr "Afficher les données uniquement pour des navigateurs spécifiques."

#: opti-behavior/includes/tooltip-helper.php:1582
msgid "Show data only for specific devices."
msgstr "Afficher les données uniquement pour des appareils spécifiques."

#: opti-behavior/includes/tooltip-helper.php:1594
msgid "Show data only for visitors from specific countries."
msgstr ""
"Afficher les données uniquement pour les visiteurs de pays spécifiques."

#: opti-behavior/includes/trait-opti-behavior-settings-views.php:485
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:587
msgid "Show interaction count information on heatmaps"
msgstr ""
"Afficher les informations de comptage des interactions sur les cartes de "
"chaleur"

#: opti-behavior/includes/tooltip-helper.php:425
msgid "Show messages in your browser's developer tools."
msgstr ""
"Afficher les messages dans les outils de développement de votre navigateur."

#: opti-behavior/includes/tooltip-helper.php:273
msgid ""
"Show numbers along the side of heatmaps telling you how many clicks happened"
" there."
msgstr ""
"Afficher des chiffres le long du côté des cartes de chaleur indiquant "
"combien de clics se sont produits là."

#: opti-behavior/includes/tooltip-helper.php:924
msgid "Show only clicks from people in certain countries."
msgstr "Afficher uniquement les clics de personnes dans certains pays."

#. translators: %1$s: start range, %2$s: end range, %3$s: total items, %4$s:
#. current page, %5$s: total pages
#: opti-behavior/admin/class-opti-behavior-heatmap-dashboard.php:1660
msgid "Showing %1$s–%2$s of %3$s · Page %4$s / %5$s"
msgstr "Affichage de %1$s–%2$s sur %3$s · Page %4$s / %5$s"

#: opti-behavior/includes/tooltip-helper.php:559
msgid ""
"Shows a log of recent cleanup operations with the date, type (manual, "
"scheduled, or bot), and number of sessions removed. Helps you verify that "
"automated cleanups are working correctly."
msgstr ""
"Affiche un journal des opérations de nettoyage récentes avec la date, le "
"type (manuel, programmé ou bot) et le nombre de sessions supprimées. Aide à "
"vérifier que les nettoyages automatiques fonctionnent correctement."

#: opti-behavior/includes/tooltip-helper.php:842
msgid "Shows every spot where people click on your page."
msgstr "Montre chaque endroit où les gens cliquent sur votre page."

#: opti-behavior/includes/tooltip-helper.php:841
msgid ""
"Shows exactly where visitors click on your page. Useful for seeing if people"
" find your buttons and links, or if they're clicking on things that aren't "
"clickable."
msgstr ""
"Montre exactement où les visiteurs cliquent sur votre page. Utile pour voir "
"si les gens trouvent vos boutons et liens, ou s’ils cliquent sur des choses "
"qui ne sont pas cliquables."

#: opti-behavior/includes/tooltip-helper.php:973
msgid "Shows how far down people scroll."
msgstr "Montre jusqu’où les gens défilent."

#: opti-behavior/includes/tooltip-helper.php:853
msgid "Shows how far down people scroll. Darker = more people see that part."
msgstr ""
"Montre jusqu’où les gens défilent. Plus foncé = plus de gens voient cette "
"partie."

#: opti-behavior/admin/class-opti-behavior-heatmap-detail-page.php:1325
#: opti-behavior/includes/tooltip-helper.php:972
msgid ""
"Shows how far down the page visitors scroll. Use this to ensure important "
"content is placed where most visitors will see it."
msgstr ""
"Montre jusqu’où les visiteurs défilent sur la page. Utilisez ceci pour vous "
"assurer que le contenu important est placé là où la plupart des visiteurs le"
" verront."

#: opti-behavior/includes/tooltip-helper.php:852
msgid ""
"Shows how far down visitors scroll on your page. The top is always visible, "
"but fewer people reach the bottom. Put important content where most people "
"will see it!"
msgstr ""
"Montre jusqu’où les visiteurs défilent sur votre page. Le haut est toujours "
"visible, mais moins de gens atteignent le bas. Placez le contenu important "
"là où la plupart des gens le verront !"

#: opti-behavior/includes/tooltip-helper.php:1434
msgid "Shows how fast your website loads for visitors."
msgstr "Montre à quelle vitesse votre site web se charge pour les visiteurs."

#: opti-behavior/includes/tooltip-helper.php:864
msgid ""
"Shows the heatmap as it appears on desktop computers (large screens). Click "
"data from computer users is shown here."
msgstr ""
"Montre la carte de chaleur telle qu’elle apparaît sur les ordinateurs de "
"bureau (grands écrans). Les données de clics des utilisateurs d’ordinateur "
"sont affichées ici."

#: opti-behavior/includes/tooltip-helper.php:869
msgid ""
"Shows the heatmap as it appears on mobile phones. Since phone users tap "
"instead of click, their behavior may be different."
msgstr ""
"Montre la carte de chaleur telle qu’elle apparaît sur les téléphones "
"mobiles. Puisque les utilisateurs de téléphone tapent au lieu de cliquer, "
"leur comportement peut être différent."

#: opti-behavior/includes/tooltip-helper.php:1320
msgid ""
"Shows the ratio of new visitors (first time here) versus returning visitors "
"(been here before). A healthy mix of both is ideal."
msgstr ""
"Montre le ratio de nouveaux visiteurs (première fois ici) versus visiteurs "
"de retour (déjà venus). Un bon mélange des deux est idéal."

#: opti-behavior/includes/tooltip-helper.php:138
msgid ""
"Shows their country, which page they're viewing, and when they arrived."
msgstr ""
"Affiche leur pays, quelle page ils consultent et quand ils sont arrivés."

#: opti-behavior/includes/tooltip-helper.php:1325
msgid ""
"Shows when the most recent visitor interaction was recorded for this page. "
"Recent activity means your page is still getting traffic."
msgstr ""
"Montre quand la plus récente interaction de visiteur a été enregistrée pour "
"cette page. Une activité récente signifie que votre page reçoit encore du "
"trafic."

#: opti-behavior/includes/tooltip-helper.php:324
msgid ""
"Shows where heatmap screenshots and recordings are stored, and how much "
"space they're using."
msgstr ""
"Montre où les captures d’écran de cartes de chaleur et les enregistrements "
"sont stockés, et combien d’espace ils utilisent."

#: opti-behavior/includes/tooltip-helper.php:963
msgid "Shows where people move their mouse."
msgstr "Montre où les gens déplacent leur souris."

#: opti-behavior/includes/tooltip-helper.php:859
msgid "Shows where people stop reading and leave your page."
msgstr "Montre où les gens arrêtent de lire et quittent votre page."

#: opti-behavior/admin/class-opti-behavior-heatmap-detail-page.php:1307
#: opti-behavior/includes/tooltip-helper.php:957
msgid ""
"Shows where visitors click on your page. Hot spots (red/orange) indicate "
"popular areas, cool spots (blue/green) show less clicked areas."
msgstr ""
"Montre où les visiteurs cliquent sur votre page. Les points chauds "
"(rouge/orange) indiquent les zones populaires, les points froids (bleu/vert)"
" montrent les zones moins cliquées."

#: opti-behavior/includes/tooltip-helper.php:1277
msgid ""
"Shows where visitors go after viewing this page. Did they click to another "
"website? Move to another page on your site? Or just close the tab?"
msgstr ""
"Montre où les visiteurs vont après avoir vu cette page. Ont-ils cliqué vers "
"un autre site web ? Passé à une autre page de votre site ? Ou simplement "
"fermé l’onglet ?"

#: opti-behavior/includes/tooltip-helper.php:1564
msgid "Shows where visitors stop filling out your form."
msgstr "Montre où les visiteurs cessent de remplir votre formulaire."

#: opti-behavior/includes/tooltip-helper.php:858
msgid ""
"Shows where visitors tend to leave your page. Identify the \"danger zones\" "
"where you're losing people and improve those sections."
msgstr ""
"Montre où les visiteurs ont tendance à quitter votre page. Identifiez les "
"« zones de danger » où vous perdez des gens et améliorez ces sections."

#: opti-behavior/includes/tooltip-helper.php:1332
msgid ""
"Shows which countries your visitors come from for this specific page. Useful"
" if you have content targeting specific regions."
msgstr ""
"Montre de quels pays viennent vos visiteurs pour cette page spécifique. "
"Utile si vous avez du contenu ciblant des régions spécifiques."

#: opti-behavior/includes/tooltip-helper.php:1558
msgid "Shows which form fields cause problems for visitors."
msgstr "Montre quels champs de formulaire posent des problèmes aux visiteurs."

#: opti-behavior/includes/tooltip-helper.php:847
