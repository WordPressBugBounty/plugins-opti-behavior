#: opti-behavior/includes/tooltip-helper.php:186
#: opti-behavior/includes/trait-opti-behavior-dashboard-views.php:1492
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:5110
msgid "Traffic Classification"
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:187
msgid ""
"Session-number basis: categorizes matching sessions by traffic source, so "
"totals reconcile with Sessions when the same date range and spam setting are"
