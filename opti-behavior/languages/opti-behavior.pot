#: opti-behavior/includes/tooltip-helper.php:1106
#: opti-behavior/includes/trait-opti-behavior-funnels-views.php:344
msgid "Suggested Funnels"
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:1107
msgid ""
"We look at the plugins and pages your site actually uses (store, blog, "
