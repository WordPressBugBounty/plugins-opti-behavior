msgid "Avg Time (heatmap interactions)"
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:911
msgid ""
"The average time associated with the captured heatmap interactions. Like "
"Clicks, this is a heatmap-interaction metric derived from recorded heatmap "
"data, not a session-based measurement."
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:912
msgid ""
"Average time from captured heatmap interactions. It is an interaction "
"metric, not a session count."
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:917
msgid "Date Range Filter"
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:918
msgid ""
"Choose which time period to analyze. Filter clicks from today only, last "
"week, last month, or view all recorded data."
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:919
msgid "Pick which days' clicks to show on the heatmap."
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:922
#: opti-behavior/includes/tooltip-helper.php:1824
msgid "Country Filter"
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:923
msgid ""
"Show clicks only from visitors in specific countries. Useful for seeing how "
"different regions interact with your page."
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:924
