msgstr ""

#: opti-behavior/includes/tooltip-helper.php:188
msgid "How people found your website."
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:189
msgid "\"Organic\" means they found you through Google or another search engine."
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:192
#: opti-behavior/includes/trait-opti-behavior-dashboard-views.php:1550
#: opti-behavior/includes/trait-opti-behavior-data-helpers.php:2498
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:5174
msgid "Bot Traffic"
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:193
msgid ""
"Session-number basis: counts sessions classified as bot, automated, spam, or"
