msgid "Visitor Map"
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:142
msgid ""
"Live visitor-number basis: maps unique active visitors by location. This "
"real-time count is separate from the selected date-range Visitors KPI."
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:143
msgid "A world map showing where your visitors are from."
msgstr ""

#: opti-behavior/includes/tooltip-helper.php:146
#: opti-behavior/includes/trait-opti-behavior-dashboard-views.php:84
#: opti-behavior/includes/trait-opti-behavior-dashboard-views.php:368
#: opti-behavior/includes/trait-opti-behavior-dashboard-views.php:459
#: opti-behavior/views/dashboard-views.php:76
#: opti-behavior/views/dashboard-views.php:215
