#: opti-behavior/includes/trait-opti-behavior-ajax-handlers.php:1511
#: opti-behavior/includes/trait-opti-behavior-assets.php:1411
#: opti-behavior/includes/trait-opti-behavior-dashboard-views.php:712
#: opti-behavior/includes/trait-opti-behavior-settings-views.php:3851
