#: opti-behavior/includes/trait-opti-behavior-ai-insights-views.php:334
msgid "Track your key path as a funnel"
msgstr ""

#: opti-behavior/includes/trait-opti-behavior-ai-insights-views.php:335
msgid "The steps visitors take before they buy or sign up."
msgstr ""

#: opti-behavior/includes/trait-opti-behavior-ai-insights-views.php:336
msgid "Create a funnel"
msgstr ""

#: opti-behavior/includes/trait-opti-behavior-ai-insights-views.php:340
msgid "Fix one problem and prove it"
msgstr ""

#: opti-behavior/includes/trait-opti-behavior-ai-insights-views.php:341
msgid "Mark a problem as fixed: the plugin measures the result for you."
msgstr ""

