msgid "Scanning your site…"
msgstr "Ihre Website wird gescannt…"

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:476
msgid "Site re-scanned. Dismissed suggestions are back."
msgstr "Website erneut gescannt. Verworfene Vorschläge sind zurück."

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:478
msgid "Upgrade to unlock"
msgstr "Zum Freischalten upgraden"

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:479
