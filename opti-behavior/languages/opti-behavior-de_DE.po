msgid "Funnel \"%1$s\" created and populated with %2$d sessions of history."
msgstr ""
"Trichter „%1$s“ erstellt und mit %2$d Sitzungen aus dem Verlauf befüllt."

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:488
msgid "A matching funnel already exists - nothing was created."
msgstr "Ein passender Trichter existiert bereits – es wurde nichts erstellt."

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:489
msgid "Could not create the funnel."
msgstr "Der Trichter konnte nicht erstellt werden."

#. translators: 1: number of funnels created, 2: number of suggestions
#. skipped.
#: opti-behavior/admin/class-opti-behavior-funnel-page.php:491
msgid "Created %1$d funnel(s), skipped %2$d."
msgstr "%1$d Trichter erstellt, %2$d übersprungen."

#. translators: 1: number of funnels created, 2: number of suggestions
#. skipped, 3: number of historical sessions replayed.
#: opti-behavior/admin/class-opti-behavior-funnel-page.php:493
msgid ""
"Created %1$d funnel(s), skipped %2$d - populated with %3$d sessions of "
"history."
msgstr ""
"%1$d Trichter erstellt, %2$d übersprungen – mit %3$d Sitzungen aus dem "
"Verlauf befüllt."

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:494
msgid "Step preview unavailable."
msgstr "Schrittvorschau nicht verfügbar."

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:495
msgid "The funnel builder is not available on this screen."
msgstr "Der Trichter-Builder ist auf diesem Bildschirm nicht verfügbar."

#. translators: 1: number of suggestions not created yet, 2: number of
#. suggestions that already have a funnel.
#: opti-behavior/admin/class-opti-behavior-funnel-page.php:498
msgid "%1$d new · %2$d created"
