msgstr "Bereits erstellt"

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:480
msgid "Similar funnel exists"
msgstr "Ähnlicher Trichter vorhanden"

#: opti-behavior/admin/class-opti-behavior-funnel-page.php:481
msgid "A funnel with these steps already exists."
